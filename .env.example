NODE_ENV=development

MYSQL_ROOT_PASSWORD=_placeholder_
MYSQL_USER=platform
MYSQL_PASSWORD=_placeholder_

RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=_placeholder_

AUTH_SERVER_PORT=3000
CONTROL_PANEL_PORT=3001
APP_A_PORT=4001
APP_B_PORT=4002
SYNC_WORKER_PORT=5000

SESSION_COOKIE_NAME=central_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

SEED_ADMIN_NAME=Development Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=_placeholder_

AUTH_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/auth_db
APP_A_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/app_a_db
APP_B_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/app_b_db
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672
