NODE_ENV=development

MYSQL_ROOT_PASSWORD=_placeholder_
MYSQL_USER=platform
MYSQL_PASSWORD=_placeholder_

RABBITMQ_DEFAULT_USER=platform
RABBITMQ_DEFAULT_PASS=_placeholder_

AUTH_SERVER_PORT=3000
CONTROL_PANEL_PORT=3001
APP_A_PORT=4001
APP_B_PORT=4002
SYNC_WORKER_PORT=5000

SESSION_COOKIE_NAME=central_session
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

SEED_ADMIN_NAME=Development Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=_placeholder_

AUTH_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/auth_db
APP_A_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/app_a_db
APP_B_DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/app_b_db
RABBITMQ_URL=amqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@rabbitmq:5672

AUTHORIZATION_CODE_TTL_SECONDS=300
ACCESS_TOKEN_TTL_SECONDS=900

SEED_APP_A_CLIENT_SECRET=_placeholder_
SEED_APP_B_CLIENT_SECRET=_placeholder_

INTERNAL_LOGOUT_SECRET=_placeholder_minimum_32_characters_
EVENT_QUEUE_NAME=sso.events
EVENT_DLQ_NAME=sso.events.dlq
EVENT_PUBLISH_INTERVAL_MS=1000
EVENT_MAX_RETRIES=5
EVENT_RETRY_BASE_MS=1000
SHUTDOWN_TIMEOUT_MS=10000

AUTH_SERVER_PUBLIC_URL=http://localhost:3000
AUTH_SERVER_INTERNAL_URL=http://auth-server:3000
APP_A_CLIENT_ID=app-a
APP_A_CLIENT_SECRET=_placeholder_
APP_A_REDIRECT_URI=http://localhost:4001/callback
APP_A_LOCAL_SESSION_COOKIE_NAME=app_a_session
APP_B_CLIENT_ID=app-b
APP_B_CLIENT_SECRET=_placeholder_
APP_B_REDIRECT_URI=http://localhost:4002/callback
APP_B_LOCAL_SESSION_COOKIE_NAME=app_b_session
LOCAL_SESSION_TTL_SECONDS=28800
OAUTH_LOGIN_ATTEMPT_TTL_SECONDS=300
MFA_CHALLENGE_TTL_SECONDS=300
