generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/auth"
}

datasource db {
  provider = "mysql"
  url      = env("AUTH_DATABASE_URL")
}

enum UserStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum ApplicationStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
}

enum SessionStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum AuthorizationCodeStatus {
  ACTIVE  @map("active")
  USED    @map("used")
  EXPIRED @map("expired")
}

enum AccessTokenStatus {
  ACTIVE  @map("active")
  EXPIRED @map("expired")
  REVOKED @map("revoked")
}

enum EventStatus {
  PENDING   @map("pending")
  PUBLISHED @map("published")
  FAILED    @map("failed")
}

enum DeliveryStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  SUCCEEDED  @map("succeeded")
  RETRYING   @map("retrying")
  FAILED     @map("failed")
}

model User {
  id                 String              @id @default(uuid()) @db.Char(36)
  name               String              @db.VarChar(191)
  email              String              @unique @db.VarChar(191)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  status             UserStatus          @default(ACTIVE)
  passwordChangedAt  DateTime?           @map("password_changed_at") @db.DateTime(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  groups             UserGroup[]
  centralSessions    CentralSession[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  actorAuditLogs     AuditLog[]          @relation("AuditActor")
  targetAuditLogs    AuditLog[]          @relation("AuditTarget")
  events             Event[]

  @@map("users")
}

model Group {
  id           String             @id @default(uuid()) @db.Char(36)
  name         String             @unique @db.VarChar(191)
  createdAt    DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  users        UserGroup[]
  applications ApplicationGroup[]

  @@map("groups")
}

model UserGroup {
  userId     String   @map("user_id") @db.Char(36)
  groupId    String   @map("group_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at") @db.DateTime(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_groups")
}

model Application {
  id                    String                   @id @default(uuid()) @db.Char(36)
  name                  String                   @db.VarChar(191)
  clientId              String                   @unique @map("client_id") @db.VarChar(191)
  clientSecretHash      String                   @map("client_secret_hash") @db.VarChar(255)
  launchUrl             String?                  @map("launch_url") @db.VarChar(2048)
  logoutNotificationUrl String                   @map("logout_notification_url") @db.VarChar(2048)
  redirectUris          ApplicationRedirectUri[]
  status                ApplicationStatus        @default(ACTIVE)
  createdAt             DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  groups                ApplicationGroup[]
  authorizationCodes    AuthorizationCode[]
  accessTokens          AccessToken[]
  auditLogs             AuditLog[]
  events                Event[]
  deliveries            EventDelivery[]

  @@map("applications")
}

model ApplicationRedirectUri {
  id              String      @id @default(uuid()) @db.Char(36)
  applicationId   String      @map("application_id") @db.Char(36)
  redirectUri     String      @map("redirect_uri") @db.VarChar(2048)
  redirectUriHash String      @map("redirect_uri_hash") @db.Char(64)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, redirectUriHash])
  @@map("application_redirect_uris")
}

model ApplicationGroup {
  applicationId String      @map("application_id") @db.Char(36)
  groupId       String      @map("group_id") @db.Char(36)
  assignedAt    DateTime    @default(now()) @map("assigned_at") @db.DateTime(3)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([applicationId, groupId])
  @@index([groupId])
  @@map("application_groups")
}

model CentralSession {
  id                 String              @id @default(uuid()) @db.Char(36)
  sessionTokenHash   String              @unique @map("session_token_hash") @db.Char(64)
  userId             String              @map("user_id") @db.Char(36)
  status             SessionStatus       @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt          DateTime            @map("expires_at") @db.DateTime(3)
  lastActivityAt     DateTime?           @map("last_activity_at") @db.DateTime(3)
  revokedAt          DateTime?           @map("revoked_at") @db.DateTime(3)
  revokeReason       String?             @map("revoke_reason") @db.VarChar(191)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]
  auditLogs          AuditLog[]
  events             Event[]

  @@index([userId, status])
  @@index([expiresAt])
  @@map("central_sessions")
}

model AuthorizationCode {
  id                  String                  @id @default(uuid()) @db.Char(36)
  codeHash            String                  @unique @map("code_hash") @db.Char(64)
  userId              String                  @map("user_id") @db.Char(36)
  applicationId       String                  @map("application_id") @db.Char(36)
  centralSessionId    String                  @map("central_session_id") @db.Char(36)
  redirectUri         String                  @map("redirect_uri") @db.VarChar(2048)
  codeChallenge       String                  @map("code_challenge") @db.VarChar(128)
  codeChallengeMethod String                  @default("S256") @map("code_challenge_method") @db.VarChar(16)
  status              AuthorizationCodeStatus @default(ACTIVE)
  issuedAt            DateTime                @default(now()) @map("issued_at") @db.DateTime(3)
  expiresAt           DateTime                @map("expires_at") @db.DateTime(3)
  usedAt              DateTime?               @map("used_at") @db.DateTime(3)
  user                User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  application         Application             @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  centralSession      CentralSession          @relation(fields: [centralSessionId], references: [id], onDelete: Restrict)

  @@index([applicationId, status, expiresAt])
  @@index([centralSessionId])
  @@map("authorization_codes")
}

model AccessToken {
  id               String            @id @default(uuid()) @db.Char(36)
  tokenHash        String            @unique @map("token_hash") @db.Char(64)
  userId           String            @map("user_id") @db.Char(36)
  applicationId    String            @map("application_id") @db.Char(36)
  centralSessionId String            @map("central_session_id") @db.Char(36)
  scopes           Json?
  status           AccessTokenStatus @default(ACTIVE)
  issuedAt         DateTime          @default(now()) @map("issued_at") @db.DateTime(3)
  expiresAt        DateTime          @map("expires_at") @db.DateTime(3)
  revokedAt        DateTime?         @map("revoked_at") @db.DateTime(3)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  centralSession   CentralSession    @relation(fields: [centralSessionId], references: [id], onDelete: Restrict)

  @@index([applicationId, status, expiresAt])
  @@index([centralSessionId])
  @@map("access_tokens")
}

model AuditLog {
  id            String          @id @default(uuid()) @db.Char(36)
  eventType     String          @map("event_type") @db.VarChar(191)
  actorId       String?         @map("actor_id") @db.Char(36)
  userId        String?         @map("user_id") @db.Char(36)
  applicationId String?         @map("application_id") @db.Char(36)
  sessionId     String?         @map("session_id") @db.Char(36)
  result        String          @db.VarChar(64)
  metadata      Json?
  ipAddress     String?         @map("ip_address") @db.VarChar(45)
  createdAt     DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  actor         User?           @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  user          User?           @relation("AuditTarget", fields: [userId], references: [id], onDelete: SetNull)
  application   Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  session       CentralSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorId])
  @@index([userId])
  @@map("audit_logs")
}

model Event {
  id               String          @id @default(uuid()) @db.Char(36)
  eventType        String          @map("event_type") @db.VarChar(191)
  userId           String          @map("user_id") @db.Char(36)
  centralSessionId String?         @map("central_session_id") @db.Char(36)
  applicationId    String?         @map("application_id") @db.Char(36)
  payload          Json
  status           EventStatus     @default(PENDING)
  createdAt        DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  publishedAt      DateTime?       @map("published_at") @db.DateTime(3)
  user             User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  centralSession   CentralSession? @relation(fields: [centralSessionId], references: [id], onDelete: SetNull)
  application      Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  deliveries       EventDelivery[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("events")
}

model EventDelivery {
  id            String         @id @default(uuid()) @db.Char(36)
  eventId       String         @map("event_id") @db.Char(36)
  applicationId String         @map("application_id") @db.Char(36)
  status        DeliveryStatus @default(PENDING)
  attemptCount  Int            @default(0) @map("attempt_count")
  lastAttemptAt DateTime?      @map("last_attempt_at") @db.DateTime(3)
  nextRetryAt   DateTime?      @map("next_retry_at") @db.DateTime(3)
  processedAt   DateTime?      @map("processed_at") @db.DateTime(3)
  lastError     String?        @map("last_error") @db.Text
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([eventId, applicationId])
  @@index([status, nextRetryAt])
  @@index([applicationId])
  @@map("event_deliveries")
}
